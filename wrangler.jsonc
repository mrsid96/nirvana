{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nirvana",
  "compatibility_date": "2026-08-20",
  "observability": {
    "enabled": true
  },
  // SPA fallback is handled here. Do not add public/_redirects with /* /index.html 200.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
