rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function validMoney(value) {
      return value is int && value >= 0 && value <= 9000000000000;
    }
    function validDate(value) {
      return value is string && value.size() == 10;
    }
    function validMonth(value) {
      return value is string && value.size() == 7;
    }
    function ownerImmutable() {
      return !('userId' in resource.data)
        || request.resource.data.userId == resource.data.userId;
    }
    function ownerMatches(uid) {
      return request.resource.data.userId == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.currency in ['INR', 'USD', 'EUR', 'GBP', 'SGD', 'AED'];
      allow delete: if false;

      match /settings/{settingId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.currency in ['INR', 'USD', 'EUR', 'GBP', 'SGD', 'AED']
          && request.resource.data.theme in ['light', 'dark', 'system'];
        allow delete: if false;
      }

      match /profile/settings {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.currency in ['INR', 'USD', 'EUR', 'GBP', 'SGD', 'AED']
          && request.resource.data.theme in ['light', 'dark', 'system'];
        allow delete: if false;
      }

      match /goals/{goalId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && ownerMatches(uid)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && validMoney(request.resource.data.targetAmount);
        allow update: if isOwner(uid)
          && ownerImmutable()
          && request.resource.data.name is string
          && validMoney(request.resource.data.targetAmount);
        allow delete: if isOwner(uid);

        match /assets/{assetId} {
          allow read: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && request.resource.data.name is string
            && validMoney(request.resource.data.currentValue)
            && validMoney(request.resource.data.investedAmount);
          allow delete: if isOwner(uid);

          match /transactions/{txId} {
            allow read: if isOwner(uid);
            allow create, update: if isOwner(uid)
              && request.resource.data.type in ['INVESTMENT', 'WITHDRAWAL', 'VALUE_UPDATE']
              && validMoney(request.resource.data.amount)
              && validDate(request.resource.data.date);
            allow delete: if isOwner(uid);
          }
        }
      }

      match /assets/{assetId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && ownerMatches(uid)
          && request.resource.data.name is string
          && validMoney(request.resource.data.currentValue)
          && validMoney(request.resource.data.investedAmount)
          && request.resource.data.goalId is string;
        allow update: if isOwner(uid)
          && ownerImmutable()
          && request.resource.data.name is string
          && validMoney(request.resource.data.currentValue)
          && validMoney(request.resource.data.investedAmount);
        allow delete: if isOwner(uid);
      }

      match /transactions/{txId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && ownerMatches(uid)
          && request.resource.data.type in ['INVESTMENT', 'WITHDRAWAL', 'VALUE_UPDATE']
          && validMoney(request.resource.data.amount)
          && validDate(request.resource.data.date)
          && validMonth(request.resource.data.month)
          && request.resource.data.assetId is string
          && request.resource.data.goalId is string;
        allow update: if isOwner(uid)
          && ownerImmutable()
          && request.resource.data.type in ['INVESTMENT', 'WITHDRAWAL', 'VALUE_UPDATE']
          && validMoney(request.resource.data.amount)
          && validDate(request.resource.data.date);
        allow delete: if isOwner(uid);
      }

      match /loans/{loanId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && ownerMatches(uid)
          && request.resource.data.name is string
          && validMoney(request.resource.data.originalAmount)
          && validMoney(request.resource.data.outstandingAmount);
        allow update: if isOwner(uid)
          && ownerImmutable()
          && request.resource.data.name is string
          && validMoney(request.resource.data.originalAmount)
          && validMoney(request.resource.data.outstandingAmount);
        allow delete: if isOwner(uid);

        match /payments/{paymentId} {
          allow read: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && validMoney(request.resource.data.amount)
            && validDate(request.resource.data.date);
          allow delete: if isOwner(uid);
        }
      }

      match /loanPayments/{paymentId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && ownerMatches(uid)
          && validMoney(request.resource.data.amount)
          && validDate(request.resource.data.date)
          && validMonth(request.resource.data.month)
          && request.resource.data.loanId is string;
        allow update: if isOwner(uid)
          && ownerImmutable()
          && validMoney(request.resource.data.amount)
          && validDate(request.resource.data.date);
        allow delete: if isOwner(uid);
      }

      match /expenses/{expenseId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && ownerMatches(uid)
          && validMoney(request.resource.data.amount)
          && validDate(request.resource.data.date)
          && validMonth(request.resource.data.month);
        allow update: if isOwner(uid)
          && ownerImmutable()
          && validMoney(request.resource.data.amount)
          && validDate(request.resource.data.date);
        allow delete: if isOwner(uid);
      }

      match /income/{incomeId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && ownerMatches(uid)
          && validMoney(request.resource.data.amount)
          && validDate(request.resource.data.date)
          && validMonth(request.resource.data.month);
        allow update: if isOwner(uid)
          && ownerImmutable()
          && validMoney(request.resource.data.amount)
          && validDate(request.resource.data.date);
        allow delete: if isOwner(uid);
      }

      match /recurringRules/{ruleId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && ownerMatches(uid)
          && request.resource.data.name is string
          && request.resource.data.type in ['INVESTMENT', 'LOAN_PAYMENT', 'INCOME', 'EXPENSE']
          && validMoney(request.resource.data.amount)
          && validDate(request.resource.data.startDate);
        allow update: if isOwner(uid)
          && ownerImmutable()
          && request.resource.data.name is string
          && validMoney(request.resource.data.amount);
        allow delete: if isOwner(uid);
      }

      match /recurringActivities/{activityId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.name is string
          && request.resource.data.type in ['INVESTMENT', 'LOAN_PAYMENT', 'INCOME', 'EXPENSE']
          && validMoney(request.resource.data.amount)
          && validDate(request.resource.data.startDate);
        allow delete: if isOwner(uid);
      }

      match /scheduledOccurrences/{occurrenceId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && ownerMatches(uid)
          && validMoney(request.resource.data.expectedAmount)
          && validDate(request.resource.data.scheduledDate)
          && request.resource.data.status in ['UPCOMING', 'DUE', 'OVERDUE', 'RECORDED', 'SKIPPED'];
        allow update: if isOwner(uid)
          && ownerImmutable()
          && validMoney(request.resource.data.expectedAmount)
          && validDate(request.resource.data.scheduledDate)
          && request.resource.data.status in ['UPCOMING', 'DUE', 'OVERDUE', 'RECORDED', 'SKIPPED'];
        allow delete: if isOwner(uid);
      }

      match /monthlySummaries/{monthId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && validMoney(request.resource.data.income)
          && validMoney(request.resource.data.expenses)
          && validMoney(request.resource.data.investments)
          && validMoney(request.resource.data.withdrawals)
          && validMoney(request.resource.data.loanPayments);
        allow delete: if false;
      }
    }
  }
}
