rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function validMoney(value) {
      return value is int && value >= 0 && value <= 9000000000000;
    }
    function validDate(value) {
      return value is string && value.size() == 10;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.currency in ['INR', 'USD', 'EUR', 'GBP', 'SGD', 'AED'];
      allow delete: if false;

      match /profile/settings {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.currency in ['INR', 'USD', 'EUR', 'GBP', 'SGD', 'AED']
          && request.resource.data.theme in ['light', 'dark', 'system'];
        allow delete: if false;
      }

      match /goals/{goalId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && validMoney(request.resource.data.targetAmount);
        allow delete: if isOwner(uid);

        match /assets/{assetId} {
          allow read: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && request.resource.data.name is string
            && validMoney(request.resource.data.currentValue)
            && validMoney(request.resource.data.investedAmount);
          allow delete: if isOwner(uid);

          match /transactions/{txId} {
            allow read: if isOwner(uid);
            allow create, update: if isOwner(uid)
              && request.resource.data.type in ['INVESTMENT', 'WITHDRAWAL', 'VALUE_UPDATE']
              && validMoney(request.resource.data.amount)
              && validDate(request.resource.data.date);
            allow delete: if isOwner(uid);
          }
        }
      }

      match /loans/{loanId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.name is string
          && validMoney(request.resource.data.originalAmount)
          && validMoney(request.resource.data.outstandingAmount);
        allow delete: if isOwner(uid);

        match /payments/{paymentId} {
          allow read: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && validMoney(request.resource.data.amount)
            && validDate(request.resource.data.date);
          allow delete: if isOwner(uid);
        }
      }

      match /expenses/{expenseId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && validMoney(request.resource.data.amount)
          && validDate(request.resource.data.date);
        allow delete: if isOwner(uid);
      }

      match /income/{incomeId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && validMoney(request.resource.data.amount)
          && validDate(request.resource.data.date);
        allow delete: if isOwner(uid);
      }
    }
  }
}